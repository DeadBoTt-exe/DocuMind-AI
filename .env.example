# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Cloud: use the cluster endpoint and an API key from the Qdrant console.
# Leave both unset to use a local Qdrant on localhost:6333.
QDRANT_URL=https://<your-cluster-id>.<region>.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional: set an API key to protect the public /ask endpoint on Cloud Run
# Clients must provide this in the 'X-API-Key' header. Leave unset to disable auth.
# API_KEY=your_secret_api_key_here
